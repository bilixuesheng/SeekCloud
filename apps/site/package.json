{
  "name": "@seekcloud/site",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./src/server/index.ts",
    "./testing": "./src/testing/index.ts",
    "./client": "./src/client/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "vite build && vite build -c vite.server.config.ts",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "admin:reset-password": "tsx src/server/cli/reset-password.ts",
    "host:create": "tsx src/server/cli/host.ts create",
    "host:revoke": "tsx src/server/cli/host.ts revoke",
    "model-catalog": "tsx src/server/cli/model-catalog.ts",
    "openapi:export": "UPDATE_ANDROID_API=1 vitest run src/server/android-api.test.ts",
    "android:strings": "UPDATE_ANDROID_STRINGS=1 vitest run src/client/i18n/android.test.ts"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-openapi": "^1.6.3",
    "@seekcloud/protocol": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-mdast": "^10.1.3",
    "hono": "^4.13.14",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uqr": "0.1.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "playwright-core": "1.63.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
